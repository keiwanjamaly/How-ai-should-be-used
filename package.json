{
  "name": "obsidian-ai-chat",
  "version": "0.1.2",
  "description": "Chat with LLMs from a sidebar panel in Obsidian using OpenRouter or ChatGPT via Codex OAuth.",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
