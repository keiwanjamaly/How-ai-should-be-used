    "esbuild": "^0.27.0",
    "obsidian": "^1.6.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "diff": "^8.0.4",
    "sql.js": "^1.12.0"
  }
